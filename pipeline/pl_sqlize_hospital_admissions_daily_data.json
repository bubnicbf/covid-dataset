{
	"name": "pl_sqlize_hospital_admissions_daily_data",
	"properties": {
		"activities": [
			{
				"name": "begin_load",
				"description": "Registers the run in covid_etl.load_audit and clears this run's staging rows.",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[covid_etl].[usp_begin_load]",
					"storedProcedureParameters": {
						"pipeline_name": {
							"value": {
								"value": "@pipeline().Pipeline",
								"type": "Expression"
							},
							"type": "String"
						},
						"pipeline_run_id": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "Guid"
						},
						"target_table": {
							"value": "hospital_admissions_daily",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_sql_covid_db",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "copy hospital admissions daily",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "begin_load",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"wildcardFileName": "*",
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						},
						"additionalColumns": [
							{
								"name": "load_run_id",
								"value": {
									"value": "@pipeline().RunId",
									"type": "Expression"
								}
							}
						]
					},
					"sink": {
						"type": "AzureSqlSink",
						"preCopyScript": {
							"value": "EXEC covid_etl.usp_clear_staged_load @target_table = N'hospital_admissions_daily', @pipeline_run_id = '@{pipeline().RunId}';",
							"type": "Expression"
						},
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_processed_hospital_admissions_daily",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_sql_staging_hospital_admissions_daily",
						"type": "DatasetReference"
					}
				],
				"description": "Copies the processed snapshot into run-scoped staging (covid_staging.hospital_admissions_daily). Production is never written here."
			},
			{
				"name": "validate_staged_snapshot",
				"description": "Rejects empty, partial, NULL-key or duplicate-key snapshots before publication.",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "copy hospital admissions daily",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[covid_etl].[usp_validate_hospital_admissions_daily]",
					"storedProcedureParameters": {
						"allow_empty": {
							"value": {
								"value": "@pipeline().parameters.allowEmptySnapshot",
								"type": "Expression"
							},
							"type": "Boolean"
						},
						"expected_row_count": {
							"value": {
								"value": "@activity('copy hospital admissions daily').output.rowsCopied",
								"type": "Expression"
							},
							"type": "Int64"
						},
						"pipeline_run_id": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "Guid"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_sql_covid_db",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "publish_snapshot",
				"description": "Replaces covid_reporting.hospital_admissions_daily with the validated snapshot in one transaction under an exclusive app lock. Idempotent on retry.",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "validate_staged_snapshot",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:30:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[covid_etl].[usp_publish_hospital_admissions_daily]",
					"storedProcedureParameters": {
						"allow_empty": {
							"value": {
								"value": "@pipeline().parameters.allowEmptySnapshot",
								"type": "Expression"
							},
							"type": "Boolean"
						},
						"pipeline_run_id": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "Guid"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_sql_covid_db",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "record_load_failure",
				"description": "Runs when any step fails: marks the audit row Failed and clears this run's staging rows. Production is untouched.",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "publish_snapshot",
						"dependencyConditions": [
							"Failed",
							"Skipped"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[covid_etl].[usp_record_load_failure]",
					"storedProcedureParameters": {
						"error_summary": {
							"value": {
								"value": "@concat('ADF activity failure in pipeline ', pipeline().Pipeline, '; see ADF Monitor for run ', pipeline().RunId)",
								"type": "Expression"
							},
							"type": "String"
						},
						"pipeline_name": {
							"value": {
								"value": "@pipeline().Pipeline",
								"type": "Expression"
							},
							"type": "String"
						},
						"pipeline_run_id": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "Guid"
						},
						"target_table": {
							"value": "hospital_admissions_daily",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_sql_covid_db",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "fail_pipeline",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "record_load_failure",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": {
						"value": "@concat('Load of covid_reporting.hospital_admissions_daily failed; the previous production snapshot was kept. Pipeline run ', pipeline().RunId, '. See covid_etl.load_audit.')",
						"type": "Expression"
					},
					"errorCode": "SqlSnapshotLoadFailed"
				}
			}
		],
		"concurrency": 1,
		"parameters": {
			"allowEmptySnapshot": {
				"type": "bool",
				"defaultValue": false
			}
		},
		"folder": {
			"name": "sqlize"
		},
		"annotations": []
	}
}