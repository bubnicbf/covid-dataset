{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "vishal-covid-reporting-adf"
		},
		"ls_ablob_covidreporting_sa_serviceEndpoint": {
			"type": "string"
		},
		"ls_adls_covidreporting_dl_url": {
			"type": "string"
		},
		"ls_sql_covid_db_server": {
			"type": "string"
		},
		"ls_sql_covid_db_database": {
			"type": "string"
		},
		"tr_ingest_population_data_scope": {
			"type": "string"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "vishal-covid-reporting-adf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2018-02-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_ablob_covidreporting_sa_serviceEndpoint": {
						"value": "[parameters('ls_ablob_covidreporting_sa_serviceEndpoint')]"
					},
					"ls_adls_covidreporting_dl_url": {
						"value": "[parameters('ls_adls_covidreporting_dl_url')]"
					},
					"ls_sql_covid_db_server": {
						"value": "[parameters('ls_sql_covid_db_server')]"
					},
					"ls_sql_covid_db_database": {
						"value": "[parameters('ls_sql_covid_db_database')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "vishal-covid-reporting-adf_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2018-02-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"tr_ingest_population_data_scope": {
						"value": "[parameters('tr_ingest_population_data_scope')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'vishal-covid-reporting-adf_ArmTemplate_0')]"
			]
		}
	]
}